{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/content-contract.schema.json",
  "title": "AgentOS Content Contract",
  "type": "object",
  "required": ["kind", "version", "backend_type", "capability_mode", "completion_state"],
  "properties": {
    "kind": {"type": "string", "enum": ["content_query", "content_match", "content_stream", "content_lyrics", "content_metadata"]},
    "version": {"type": "integer", "minimum": 1},
    "backend_type": {"type": "string", "enum": ["platform_backend", "third_party_api", "self_hosted"]},
    "capability_mode": {"type": "string", "enum": ["real", "mock", "unavailable", "degraded"]},
    "completion_state": {"type": "string", "enum": ["DONE", "DONE_WITH_CONCERNS", "BLOCKED", "NEEDS_CONTEXT"]},
    "error_code": {"type": "string", "enum": ["NO_RESULT", "AUTH_FAILED", "REGION_RESTRICTED", "COPYRIGHT_RESTRICTED", "BACKEND_UNAVAILABLE"]},
    "query": {"$ref": "#/$defs/query"},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "match": {"$ref": "#/$defs/match"},
    "track": {"$ref": "https://agentos.dev/schemas/track.schema.json"},
    "stream_id": {"type": "integer", "minimum": 1},
    "track_id": {"type": "string"},
    "url": {"type": "string"},
    "auth": {"$ref": "#/$defs/auth"},
    "format": {"type": "string", "enum": ["mp3", "aac", "flac"]},
    "bitrate": {"type": "integer", "minimum": 64000},
    "expires_at": {"type": "string"},
    "lines": {"type": "array", "items": {"$ref": "#/$defs/lyricLine"}},
    "title": {"type": "string"},
    "artist": {"type": "string"},
    "album": {"type": "string"},
    "duration_ms": {"type": "integer", "minimum": 1},
    "cover_url": {"type": "string"},
    "runtime_mode": {"$ref": "https://agentos.dev/schemas/runtime-mode.schema.json"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "content_query"}, "completion_state": {"const": "DONE"}}, "required": ["kind", "completion_state"]}, "then": {"required": ["query", "candidates"]}},
    {"if": {"properties": {"kind": {"const": "content_match"}, "completion_state": {"const": "DONE"}}, "required": ["kind", "completion_state"]}, "then": {"required": ["match", "track"]}},
    {"if": {"properties": {"kind": {"const": "content_stream"}, "completion_state": {"const": "DONE"}}, "required": ["kind", "completion_state"]}, "then": {"required": ["stream_id", "track_id", "url", "auth", "format", "bitrate", "expires_at"]}},
    {"if": {"properties": {"kind": {"const": "content_lyrics"}, "completion_state": {"const": "DONE"}}, "required": ["kind", "completion_state"]}, "then": {"required": ["track_id", "lines"]}},
    {"if": {"properties": {"kind": {"const": "content_metadata"}, "completion_state": {"const": "DONE"}}, "required": ["kind", "completion_state"]}, "then": {"required": ["track_id", "title", "artist", "duration_ms"]}},
    {"if": {"properties": {"capability_mode": {"const": "mock"}}, "required": ["capability_mode"]}, "then": {"properties": {"completion_state": {"enum": ["DONE_WITH_CONCERNS", "BLOCKED", "NEEDS_CONTEXT"]}}}},
    {"if": {"properties": {"capability_mode": {"const": "unavailable"}}, "required": ["capability_mode"]}, "then": {"properties": {"completion_state": {"enum": ["BLOCKED", "NEEDS_CONTEXT"]}}}},
    {"if": {"properties": {"capability_mode": {"const": "degraded"}}, "required": ["capability_mode"]}, "then": {"properties": {"completion_state": {"enum": ["DONE_WITH_CONCERNS", "BLOCKED", "NEEDS_CONTEXT"]}}}},
    {"if": {"properties": {"completion_state": {"const": "DONE"}}, "required": ["completion_state"]}, "then": {"properties": {"error_code": false}}}
  ],
  "$defs": {
    "query": {"type": "object", "required": ["keywords"], "properties": {"intent": {"type": "string"}, "keywords": {"type": "array", "items": {"type": "string"}}, "fuzzy": {"type": "boolean"}}, "additionalProperties": false},
    "candidate": {"type": "object", "required": ["track_id", "title", "artist"], "properties": {"track_id": {"type": "string"}, "title": {"type": "string"}, "artist": {"type": "string"}, "album": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false},
    "match": {"type": "object", "required": ["title", "artist"], "properties": {"track_id": {"type": "string"}, "title": {"type": "string"}, "artist": {"type": "string"}, "album": {"type": "string"}, "isrc": {"type": "string"}}, "additionalProperties": false},
    "auth": {"type": "object", "required": ["token", "token_type", "expires_at"], "properties": {"token": {"type": "string"}, "token_type": {"type": "string", "enum": ["bearer", "query_param"]}, "expires_at": {"type": "string"}}, "additionalProperties": false},
    "lyricLine": {"type": "object", "required": ["timestamp_ms", "text"], "properties": {"timestamp_ms": {"type": "integer", "minimum": 0}, "text": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
