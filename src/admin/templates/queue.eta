<h1>待审核 ingest</h1>
<% if (it.items.length === 0) { %>
<p>无待审核 ingest</p>
<% } else { %>
<table>
<tr><th>track_id</th><th>标题</th><th>艺人</th><th>提交时间</th><th>状态</th></tr>
<% it.items.forEach(i => { %>
<tr>
<td><a href="/admin/ingest/<%= i.id %>"><%= i.track_id %></a></td>
<td><%= i.title %></td>
<td><%= i.artist %></td>
<td><%= i.created_at %></td>
<td><span class="badge badge-<%= i.state %>"><%= i.state %></span></td>
</tr>
<% }) %>
</table>
<% } %>
